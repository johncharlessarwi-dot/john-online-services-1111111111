# Example environment variables for the server
PORT=4000

# Supabase (optional). Use service role only on trusted servers.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (for signed uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local SQLite fallback path
DATABASE_PATH=./data/db.sqlite

# Required for server startup: generate a unique 32+ character secret outside Git.
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Optional one-time administrator bootstrap; disabled unless explicitly enabled.
SEED_ADMIN=false
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=provide-a-strong-unique-16-plus-character-password
